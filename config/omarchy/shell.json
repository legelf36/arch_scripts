{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "tornikegomareli.spaces",
          "showApps": "hoverOnly",
          "hideEmpty": true,
          "perMonitor": true
        },
        {
          "id": "io.github.creolben.equalizer"
        }
      ],
      "center": [
        {
          "id": "io.github.mattwolfgang.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "ubruckhaus.llm-usage"
        },
        {
          "id": "dexterhere.omallama"
        },
        {
          "id": "io.github.momostifler96.omarchy-cleaner"
        },
        {
          "id": "io.github.mtolhuys.disk-lens"
        },
        {
          "id": "io.github.juliusmork-sys.monitor-settings-extender"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Regina",
              "zone": "America/Regina"
            },
            {
              "name": "Sao Paulo",
              "zone": "America/Sao_Paulo"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            }
          ]
        },
        {
          "id": "eduardodallecort.weather-radar",
          "alertsEnabled": true,
          "alertRadiusKm": 150
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "dizziee.system-updates"
        },
        {
          "id": "omaplug"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "tray": []
    },
    "patrickfanella.monitor-bar": {
      "version": 1,
      "primary": "DP-3",
      "outputs": {
        "DP-3": {
          "mode": "full"
        },
        "HDMI-A-1": {
          "mode": "hidden"
        }
      }
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.clock"
  ],
  "cloneSourceRestores": [
    "io.github.mattwolfgang.clock"
  ]
}
